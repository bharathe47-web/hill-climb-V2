class_name RoadsideLandmarkRegistry
extends RefCounted

## RoadsideLandmarkRegistry: Authoritative unified catalog of roadside famous attractions along Indian Roads.
## Serves as the single source of truth for landmark placement, scale, depth, and classification.
## Positions real temples, forts, palaces, towers, bridges, and natural monuments
## along the player's continuous highway journey with zero overlapping collisions.

enum PlacementCategory {
	DRIVABLE_STRUCTURE,
	ROADSIDE_LANDMARK,
	BACKGROUND_LANDMARK,
	NATURAL_ATTRACTION,
	ROADSIDE_PROP
}

static func category_to_string(cat: PlacementCategory) -> String:
	match cat:
		PlacementCategory.DRIVABLE_STRUCTURE: return "drivable_structure"
		PlacementCategory.ROADSIDE_LANDMARK: return "roadside_landmark"
		PlacementCategory.BACKGROUND_LANDMARK: return "background_landmark"
		PlacementCategory.NATURAL_ATTRACTION: return "natural_attraction"
		PlacementCategory.ROADSIDE_PROP: return "roadside_prop"
		_: return "roadside_landmark"


static func get_landmark_by_id(landmark_id: String) -> Dictionary:
	for state_id in ["tamil_nadu", "goa", "kerala", "rajasthan", "gujarat", "telangana"]:
		for lm in get_landmarks_for_state(state_id):
			if lm.get("id", "") == landmark_id:
				return lm
	return {}
